    <menuitem name="Listado de Veterinarios" id="vet_clinic.menu_veterinarian_root" parent="vet_clinic.menu_veterinarian"
            action="vet_clinic.action_window_veterinarian"/>
    <menuitem name="Listado de citas" id="vet_clinic.menu_appointment_root" parent="vet_clinic.menu_appointment"
            action="vet_clinic.action_window_appointment"/>

        

    </data>
    

</odoo>
