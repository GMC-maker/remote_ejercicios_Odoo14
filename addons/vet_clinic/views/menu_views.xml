<odoo>

    <data>
    <!-- Top menu item -->
    <menuitem name="Clinica veterinaria" id="vet_clinic.menu_root"/>
    
    <!-- menu categories -->
    <menuitem name="Veterinarios" id="vet_clinic.menu_veterinarian" parent="vet_clinic.menu_root"/>
    <menuitem name="Citas" id="vet_clinic.menu_appointment" parent="vet_clinic.menu_root"/>

    <!-- actions -->
